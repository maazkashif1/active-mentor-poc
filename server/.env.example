PORT=3000
MONGO_URI=mongodb+srv://...
JWT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://<your-render-app>.onrender.com/api/auth/google/callback
# Where OAuth should send physios after Connect (local portal or deployed)
PHYSIO_PORTAL_URL=http://localhost:5173
# Places API (New) — server-side proxy for hospital affiliation search
GOOGLE_PLACES_API_KEY=

# Region the Recall API key + dashboard webhook belong to (us-east-1, us-west-2, eu-central-1, ap-northeast-1)
RECALL_REGION=ap-northeast-1
# meeting_captions (default) | recallai_streaming (better for Urdu / mixed language)
RECALL_TRANSCRIPT_PROVIDER=meeting_captions
RECALL_API_KEY=
RECALL_WEBHOOK_SECRET=
# Dashboard webhook URL: https://<your-render-app>.onrender.com/api/webhook/recall (RECALL_WEBHOOK_BASE_URL is no longer read)
APP_TIMEZONE=Asia/Karachi

OPENAI_API_KEY=

RESEND_API_KEY=

R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=exercise-videos
R2_REGION=auto